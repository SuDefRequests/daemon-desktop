{
  "name": "daemon-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:start": "electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "test": "node tests/device.cjs && node tests/startup.mjs && node tests/inference.cjs && node tests/artifact-files.cjs && node tests/presentation.cjs && node tests/document.cjs && node tests/artifact-opener.cjs && node tests/prototype.mjs",
    "test:android": "node tests/android.mjs"
  },
  "dependencies": {
    "docx": "^9.11.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.58.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.vidur.desktop",
    "productName": "VIDUR AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "brain/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
